{
	"name": "@b1ackb/deepseek-rsi",
	"version": "0.0.0-g2.5",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": "./dist/index.js",
		"./client": "./dist/client.js",
		"./package.json": "./package.json",
		"./scenarios": {
			"types": "./dist/types/scenarios/index.d.ts",
			"import": "./dist/scenarios.js"
		}
	},
	"files": [
		"dist",
		"fixtures",
		"cordis.patch.yml",
		"patches",
		"docs",
		"AGENTS.md"
	],
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-client-ui-settings-plugins",
				"@deepseek-ai/dsh-client-ui-layout",
				"@deepseek-ai/dsh-client-ui-session",
				"@deepseek-ai/dsh-client-ui-workspace"
			]
		}
	},
	"scripts": {
		"link:harness": "node scripts/link-harness.mjs",
		"build": "node scripts/build.mjs",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
		"test": "node --test tests/*.test.ts",
		"check": "npm run typecheck && npm test && npm run build"
	},
	"dependencies": {
		"zod": "4.4.3",
		"esbuild": "0.28.2"
	},
	"devDependencies": {
		"@types/node": "25.3.0",
		"@types/react": "19.2.14",
		"typescript": "6.0.3"
	}
}
